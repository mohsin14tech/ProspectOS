{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}Integrations{% endblock %}
{% block breadcrumb %}Integrations{% endblock %}

{% block body %}
    <div class="page-heading">
        <div>
            
            <h1>Integrations</h1>
            <p class="page-subtitle">Check what is configured and test a real service operation.</p>
        </div>
    </div>

    {% for message in app.flashes('success') %}<div class="flash flash-success" role="status">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="flash flash-error" role="alert">{{ message }}</div>{% endfor %}

    <section class="integration-list" aria-label="Connected services">
        <article class="panel integration-card">
            <div class="integration-symbol" aria-hidden="true">{{ icons.icon('search', 22) }}</div>
            <div class="integration-copy">
                <div class="integration-title"><h2>Web search</h2><span class="connection-status is-configured">Configured locally</span></div>
                <p>SearXNG runs in the local Docker network. It combines public search engines and does not need an API key. Upstream engines can rate limit or omit results.</p>
                <p class="integration-meta">Search API: <code>{{ searchEndpoint }}</code></p>
                <form method="post" action="{{ path('app_integrations') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('test_search') }}">
                    <button class="button button-secondary" type="submit">Test web search</button>
                </form>
                <p class="integration-disclosure">Test sends a sample query to upstream search engines. Research objectives are also forwarded by SearXNG. Do not search for confidential or personal information.</p>
            </div>
        </article>

        <article class="panel integration-card">
            <div class="integration-symbol integration-symbol-ai" aria-hidden="true">{{ icons.icon('sparkles', 22) }}</div>
            <div class="integration-copy">
                <div class="integration-title"><h2>AI research</h2><span class="connection-status {{ aiReady ? 'is-configured' : (aiConfigured ? 'is-pending' : 'is-missing') }}">{{ aiReady ? 'Connected · test passed' : (aiConfigured ? 'Saved · test required' : (aiEnabled ? 'Setup incomplete' : 'AI disabled')) }}</span></div>
                {% if aiConfigured %}<p>{{ aiProvider }} · {{ aiTier|trim('.', 'right') }}.</p>{% elseif aiEnabled %}<p>{{ aiProvider }} is selected, but its endpoint/model or credentials are incomplete. AI analysis stays unavailable until configuration passes validation.</p>{% else %}<p>AI is off. Set up a cloud provider or connect a local Ollama model for this workspace.</p>{% endif %}
                <p class="integration-meta">Configured model: <code>{{ aiModel }}</code></p>
                <p class="integration-meta"><a href="{{ path('app_integrations_ai') }}">Configure AI provider</a></p>
                {% if aiConfigured %}
                    <form method="post" action="{{ path('app_integrations') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('test_search') }}">
                        <input type="hidden" name="test" value="ai">
                        <button class="button button-secondary" type="submit">Test AI provider</button>
                    </form>
                    <p class="integration-disclosure">{{ aiDisclosure }}</p>
                {% else %}
                    <p class="integration-meta">Choose Gemini, OpenAI, Groq, OpenRouter, Hugging Face, or local Ollama. API keys are encrypted in this workspace and never shown again.</p>
                {% endif %}
            </div>
        </article>

        <article class="panel integration-card">
            <div class="integration-symbol integration-symbol-mail" aria-hidden="true">{{ icons.icon('mail', 22) }}</div>
            <div class="integration-copy">
                <div class="integration-title"><h2>Gmail outreach</h2><span class="connection-status {{ gmailConnection ? 'is-configured' : 'is-missing' }}">{{ gmailConnection ? 'Connected · draft only' : 'Not connected' }}</span></div>
                <p>Gmail supports recent inbox reads and drafts for review in Gmail. Standard IMAP/SMTP mailbox setup supports inbox reads and approved test sends.</p>
                <p class="integration-meta"><a href="{{ path('app_outreach') }}">Open email setup</a>. Google OAuth client setup and Gmail API access are required.</p>
            </div>
        </article>
    </section>
{% endblock %}
