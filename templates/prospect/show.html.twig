{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}{{ prospect.name }} · Prospect report{% endblock %}
{% block breadcrumb %}Prospect report{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/court.css') }}">{% endblock %}
{% block body %}
{% for message in app.flashes('success') %}<div class="flash flash-success" role="status">{{ message }}</div>{% endfor %}
{% for message in app.flashes('error') %}<div class="flash flash-error" role="alert">{{ message }}</div>{% endfor %}
<div class="page-heading prospect-report-heading">
    <div>
        <a class="text-link report-back" href="{{ path('app_dashboard') }}#prospects">{{ icons.icon('chevron-left', 16) }}Back to prospects</a>
        <div class="eyebrow"><span class="eyebrow-dot"></span>Evidence brief · {{ prospect.sourceMode|replace({'_': ' '})|title }}</div>
        <h1>{{ prospect.name }}</h1>
        <p class="page-subtitle">{{ prospect.category }} · {{ prospect.location }}{% if prospect.canonicalDomain %} · {{ prospect.canonicalDomain }}{% endif %}</p>
    </div>
    {% if prospect.sourceMode == 'web_search' %}<span class="status-tag">Unverified search candidate</span>{% elseif prospect.sourceMode == 'demo' %}<span class="status-tag">Synthetic sample</span>{% else %}<span class="status-tag status-completed">Website inspected</span>{% endif %}
</div>

<div class="report-layout">
    <main class="report-main">
        <section class="panel court-cta" aria-labelledby="court-cta-title">
            <div>
                <h2 id="court-cta-title">Put this lead on trial</h2>
                <p>An AI Advocate and an AI Skeptic argue from the sources below. Claims without a citation are struck automatically. You rule.</p>
            </div>
            {% if courtReady %}
                <form method="post" action="{{ path('app_court_open', {id: prospect.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('court_open_' ~ prospect.id) }}">
                    <button class="button button-primary" type="submit">{{ icons.icon('scale', 16) }}{{ courtReplay ? 'Watch a recorded hearing' : 'Open Evidence Court' }}</button>
                </form>
            {% else %}
                <a class="button button-secondary" href="{{ path('app_integrations_ai') }}">Connect AI to open court</a>
            {% endif %}
        </section>
        <section class="panel evidence-panel" aria-labelledby="lead-memory-title">
            <div class="panel-heading"><div><h2 id="lead-memory-title">Team memory</h2><p>Save a human decision and its reason. Future reports can use reviewed examples from this workspace.</p></div><span class="status-tag">{{ prospect.status|replace({'_': ' '})|title }}</span></div>
            <form method="post" action="{{ path('app_prospect_decide', {id: prospect.id}) }}" class="auth-form">
                <input type="hidden" name="_token" value="{{ csrf_token('decide_prospect_' ~ prospect.id) }}">
                <label for="prospect-decision">Your decision</label>
                <select id="prospect-decision" name="decision" required>
                    <option value="needs_review">Needs more review</option>
                    <option value="finalized">Finalize for team memory</option>
                    <option value="rejected">Reject and remember why</option>
                    <option value="archived">Archive</option>
                </select>
                <label for="decision-reason">Why? <span>Required · 3–1000 characters</span></label>
                <textarea id="decision-reason" name="reason" rows="3" minlength="3" maxlength="1000" required placeholder="For example: Keep because the source confirms a likely fit; verify the contact before outreach."></textarea>
                <button class="button button-primary" type="submit">Save decision</button>
            </form>
            {% if decisions is not empty %}
                <h3>Decision history</h3>
                <ol class="activity-list">
                    {% for item in decisions %}<li class="activity-item"><span class="timeline-mark mark-research" aria-hidden="true">✓</span><div><strong>{{ item.decision|replace({'_': ' '})|title }}</strong><p>{{ item.reason }}</p><time>{{ item.actor.email }} · {{ item.createdAt|date('d M Y, H:i') }}</time></div></li>{% endfor %}
                </ol>
            {% endif %}
        </section>

        {% if memoryExamples is not empty %}
            <section class="panel evidence-panel" aria-labelledby="memory-examples-title">
                <div class="panel-heading"><div><h2 id="memory-examples-title">Similar reviewed leads</h2><p>These workspace decisions may help frame this review. They are not evidence about this company.</p></div></div>
                <ul class="evidence-list">{% for item in memoryExamples %}<li class="evidence-card"><h3><a href="{{ path('app_prospect_show', {id: item.prospect.id}) }}">{{ item.prospect.name }}</a> · {{ item.decision|replace({'_': ' '})|title }}</h3><p>{{ item.reason }}</p><small>{{ item.prospect.category }} · {{ item.prospect.location }} · {{ item.createdAt|date('d M Y') }}</small></li>{% endfor %}</ul>
            </section>
        {% endif %}

        <section class="panel evidence-panel" aria-labelledby="outreach-title">
            <div class="panel-heading"><div><h2 id="outreach-title">Prepare email outreach</h2><p>Write a draft in Gmail for you to review. ProspectOS will not send it.</p></div></div>
            {% if prospect.status != 'finalized' %}
                <p class="integration-disclosure">Finalize this lead in Team memory before preparing an outreach draft.</p>
            {% elseif not gmailConnection %}
                <p class="integration-disclosure">Connect Gmail to create a provider-side draft. <a href="{{ path('app_outreach') }}">Open email setup</a>.</p>
            {% else %}
                <form method="post" action="{{ path('app_outreach_create_draft', {id: prospect.id}) }}" class="auth-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('create_outreach_draft_' ~ prospect.id) }}">
                    <label for="outreach-recipient">Recipient email</label><input id="outreach-recipient" name="recipient" type="email" maxlength="180" autocomplete="email" required>
                    <label for="outreach-subject">Subject</label><input id="outreach-subject" name="subject" type="text" maxlength="900" required value="A question for {{ prospect.name }}">
                    <label for="outreach-body">Message</label><textarea id="outreach-body" name="body" rows="7" maxlength="20000" required placeholder="Write and review the message you want saved as a Gmail draft."></textarea>
                    <label class="source-option" for="contact-checked"><input id="contact-checked" type="checkbox" name="contact_checked" value="1" required><span><strong>I checked this recipient and have a valid basis to contact them.</strong><small>I will review the Gmail draft before deciding whether to send it.</small></span></label>
                    <button class="button button-primary" type="submit">Create Gmail draft</button>
                    <p class="integration-disclosure">Creating a Gmail draft is an external account change. The app records who created it, the recipient, subject and provider draft ID. Message body stays in Gmail. Sending is not available in ProspectOS.</p>
                </form>
            {% endif %}
        </section>

        <section class="panel evidence-panel" aria-labelledby="evidence-title">
            <div class="panel-heading"><div><h2 id="evidence-title">Sources and findings</h2><p>Only saved source material is shown here. Review each page before relying on it.</p></div><span class="evidence-count">{{ evidence|length }} {{ evidence|length == 1 ? 'item' : 'items' }}</span></div>
            {% if evidence is empty %}
                <div class="empty-note">No evidence has been saved for this prospect yet.</div>
            {% else %}
                <ol class="evidence-list">
                {% for item in evidence %}
                    <li class="evidence-card" id="evidence-{{ item.id }}">
                        <div class="evidence-card-top"><span class="evidence-state state-{{ item.verificationState }}">{{ item.verificationState|replace({'_': ' '})|title }}</span><time datetime="{{ item.retrievedAt|date('c') }}">{{ item.retrievedAt|date('d M Y, H:i') }}</time></div>
                        <h3>{% if item.sourceUrl %}<a href="{{ item.sourceUrl }}" target="_blank" rel="noopener noreferrer">{{ item.sourceTitle }}</a>{% else %}{{ item.sourceTitle }}{% endif %}</h3>
                        <p class="evidence-claim">{{ item.claim }}</p>
                        {% if item.supportingExcerpt %}<blockquote>{{ item.supportingExcerpt }}</blockquote>{% endif %}
                        <div class="evidence-meta"><span>{{ item.findingType|replace({'_': ' '})|title }}</span><span>{{ item.retrievalMethod|replace({'_': ' '})|title }}</span>{% if item.confidence is not null %}<span>{{ (item.confidence * 100)|round }}% source confidence</span>{% endif %}</div>
                    </li>
                {% endfor %}
                </ol>
            {% endif %}
        </section>

        <section class="panel evidence-panel" aria-labelledby="ai-summary-title">
            <div class="panel-heading"><div><h2 id="ai-summary-title">AI evidence summary</h2><p>Generated only from saved sources. Citations link to the source records below.</p></div></div>
            {% if summary %}
                <div class="evidence-summary-text">{{ summary.summary|nl2br }}</div>
                <div class="evidence-meta"><span>{{ summary.provider }}</span><span>{{ summary.model }}</span><time datetime="{{ summary.createdAt|date('c') }}">{{ summary.createdAt|date('d M Y, H:i') }}</time></div>
                <div class="summary-citations" aria-label="Evidence provided to the summary">
                    {% for item in evidence %}{% if item.id in summary.evidenceIds %}<a class="text-link" href="#evidence-{{ item.id }}">E{{ item.id }} · {{ item.sourceTitle }}</a>{% endif %}{% endfor %}
                </div>
            {% else %}
                <p class="score-empty">No AI summary has been generated for this report.</p>
            {% endif %}
            <form method="post" action="{{ path('app_prospect_analyze', {id: prospect.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('analyze_prospect_' ~ prospect.id) }}">
                <button class="button button-primary" type="submit" {% if not aiConfigured or evidence is empty %}disabled{% endif %}>{{ summary ? 'Refresh evidence summary' : 'Generate evidence summary' }}</button>
            </form>
            {% if not aiConfigured %}<p class="integration-disclosure">AI is disabled or the selected provider is not configured. Review Integrations to choose a provider and store its credentials in the ignored app environment.</p>{% elseif evidence is empty %}<p class="integration-disclosure">Save source evidence before asking for a summary.</p>{% endif %}
            {% if aiConfigured %}<p class="integration-disclosure">{{ aiProvider }} · {{ aiModel }} · {{ aiTier }}. {{ aiDisclosure }} Limited to 10 requests per signed-in user each hour.</p>{% endif %}
        </section>

        <section class="panel origin-panel" aria-labelledby="origin-title">
            <div class="panel-heading"><div><h2 id="origin-title">Research context</h2><p>The objective that produced this record</p></div></div>
            <p class="origin-objective">{{ prospect.researchRun.objective }}</p>
            <div class="origin-meta"><span>{{ prospect.researchRun.status|capitalize }}</span><span>{{ prospect.researchRun.createdAt|date('d M Y, H:i') }}</span><span>{{ prospect.researchRun.sourceMode|replace({'_': ' '})|title }}</span></div>
        </section>
    </main>

    <aside class="report-aside">
        <section class="panel score-panel" aria-labelledby="score-title">
            <div class="panel-heading"><div><h2 id="score-title">Opportunity score</h2><p>Deterministic score from available dimensions</p></div></div>
            {% if score and score.score is not null %}
                <div class="score-summary"><strong>{{ score.score }}</strong><span>/ 100</span><small>{{ score.coverage }}% dimension coverage</small></div>
                <dl class="score-breakdown">
                {% set dimensionLabels = {icpFit: 'Ideal customer fit', opportunity: 'Observable opportunity', evidenceQuality: 'Evidence quality', contactability: 'Contactability', intentRecency: 'Intent and recency'} %}
                {% for key, dimension in score.breakdown %}
                    <div><dt>{{ dimensionLabels[key]|default(key|title) }} <span>{{ dimension.weight }}% weight</span></dt><dd>{% if dimension.value is not null %}{{ dimension.value }}/100{% else %}<span class="unknown-value">Unknown</span>{% endif %}</dd></div>
                {% endfor %}
                </dl>
                <p class="score-note">Unknown dimensions are excluded from the total and reduce coverage. This score is not a verification of business identity or fit.</p>
            {% else %}
                <div class="score-empty"><span class="score-unrated">Not scored</span><p>There is not enough verified evidence to calculate an opportunity score.</p></div>
            {% endif %}
        </section>
        <section class="report-note"><strong>Evidence first</strong><p>This brief is assembled from stored research records. It does not generate AI conclusions or confirm that a search result is the right business.</p></section>
    </aside>
</div>
{% endblock %}
