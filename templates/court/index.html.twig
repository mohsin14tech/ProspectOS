{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}Evidence Court{% endblock %}
{% block breadcrumb %}Evidence Court{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/court.css') }}">{% endblock %}

{% block body %}
{% for message in app.flashes('error') %}<div class="flash flash-error" role="alert">{{ message }}</div>{% endfor %}
<div class="page-heading">
    <div>
        
        <h1>Evidence Court</h1>
        <p class="page-subtitle">Put a lead on trial before you spend time on it. An AI Advocate and an AI Skeptic argue from your saved sources. A program strikes every claim that lacks a citation. You rule, and your ruling becomes team memory.</p>
    </div>
</div>

<ol class="court-steps" aria-label="How a hearing works">
    <li><span>1</span><strong>Pick a lead</strong><small>Any researched prospect with saved evidence</small></li>
    <li><span>2</span><strong>Counsel argue</strong><small>Two Symfony AI agents call read-only evidence tools</small></li>
    <li><span>3</span><strong>Clerk checks</strong><small>Uncited or invented claims are struck by code</small></li>
    <li><span>4</span><strong>You rule</strong><small>Pursue, reject or ask for more evidence</small></li>
</ol>

{% if not aiReady %}
    <section class="panel court-setup" role="note">
        <div>
            <h2>Connect an AI model first</h2>
            <p>Counsel need a tested AI connection. A free cloud key (Groq or Hugging Face) takes about a minute; local Ollama works offline.{% if workspace.slug == 'demo' %} Until then, the three demo leads replay recorded hearings so you can see how it works.{% endif %}</p>
        </div>
        <a class="button button-primary" href="{{ path('app_integrations_ai') }}">Connect AI</a>
    </section>
{% endif %}

<div class="court-index-grid">
    <section class="panel" aria-labelledby="docket-title">
        <div class="panel-heading"><div><h2 id="docket-title">Open a case</h2><p>Leads in this workspace, most recently updated first.</p></div></div>
        {% if prospects is empty %}
            <div class="empty-note">No leads yet. <a href="{{ path('app_research') }}">Run research</a> to find some.</div>
        {% else %}
            <ul class="court-docket">
                {% for prospect in prospects %}
                    <li>
                        <div><a href="{{ path('app_prospect_show', {id: prospect.id}) }}"><strong>{{ prospect.name }}</strong></a><small>{{ prospect.category }} · {{ prospect.location }} · {{ prospect.status|replace({'_': ' '})|title }}</small></div>
                        <form method="post" action="{{ path('app_court_open', {id: prospect.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('court_open_' ~ prospect.id) }}">
                            <button class="button button-secondary" type="submit" {{ aiReady or prospect.id in replayable ? '' : 'disabled' }}>{{ icons.icon('scale', 16) }}{{ prospect.id in replayable ? 'Watch recorded hearing' : 'Open hearing' }}</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="panel" aria-labelledby="cases-title">
        <div class="panel-heading"><div><h2 id="cases-title">Hearings</h2><p>Every hearing is kept, including struck claims.</p></div></div>
        {% if cases is empty %}
            <div class="empty-note">No hearings yet. Open one to see the court in action.</div>
        {% else %}
            <ul class="court-docket">
                {% for case in cases %}
                    <li>
                        <div><a href="{{ path('app_court_show', {id: case.id}) }}"><strong>#{{ case.id }} {{ case.prospect.name }}</strong></a>
                            <small>{% if case.transcript.advocate is defined and case.transcript.skeptic is defined %}{{ case.transcript.advocate.admitted }} for, {{ case.transcript.skeptic.admitted }} against. {% endif %}Opened {{ case.openedVia == 'mcp' ? 'from an MCP client' : 'in the app' }}, {{ case.createdAt|date('j M, H:i') }}</small></div>
                        <span class="status-tag court-status court-status-{{ case.status }}">{{ {pending: 'In progress', argued: 'Awaiting ruling', ruled: 'Ruled', failed: 'Failed'}[case.status] }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
