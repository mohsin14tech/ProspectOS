{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}Evidence Court #{{ case.id }} · {{ prospect.name }}{% endblock %}
{% block breadcrumb %}Evidence Court{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/court.css') }}">{% endblock %}

{% block body %}
{% for message in app.flashes('success') %}<div class="flash flash-success" role="status">{{ message }}</div>{% endfor %}
{% for message in app.flashes('error') %}<div class="flash flash-error" role="alert">{{ message }}</div>{% endfor %}

<div class="page-heading court-heading">
    <div>
        <a class="text-link report-back" href="{{ path('app_prospect_show', {id: prospect.id}) }}">{{ icons.icon('chevron-left', 16) }}Back to {{ prospect.name }}</a>
        <div class="eyebrow"><span class="eyebrow-dot"></span>Evidence Court · Case #{{ case.id }}</div>
        <h1>Should we pursue {{ prospect.name }}?</h1>
        <p class="page-subtitle">Two AI colleagues talk it through using only the saved evidence. A simple program removes anything said without proof. Then you decide.</p>
    </div>
    <span class="status-tag court-status court-status-{{ case.status }}">{{ {pending: 'Hearing in progress', argued: 'Awaiting your ruling', ruled: 'Ruled', failed: 'Hearing failed'}[case.status] }}</span>
</div>

{% if case.provider == 'Recorded demo' %}
    <p class="court-replay-note" role="note"><strong>Recorded demo hearing.</strong> No AI is connected, so the AI's words were recorded earlier ({{ case.model }}) and replayed. The evidence tools and the clerk ran just now. <a href="{{ path('app_integrations_ai') }}">Connect an AI</a> for live hearings.</p>
{% endif %}

{% if case.status == 'pending' %}
    <section class="panel court-chat is-live" aria-labelledby="chat-title"
             data-controller="court-live" data-court-live-url-value="{{ path('app_court_live', {id: case.id}) }}" data-court-live-done-value="{{ path('app_court_show', {id: case.id}) }}">
        <header class="chat-head">
            <h2 id="chat-title">The conversation <span class="chat-live-dot">Live</span></h2>
            <p class="chat-live-note">The Advocate makes the case, the Skeptic replies to each point, then the Advocate answers back. Messages appear as they are written.</p>
        </header>
        <ol class="chat-thread" data-court-live-target="thread">
            {{ include('court/_thread.html.twig') }}
        </ol>
        <noscript><p>This page needs JavaScript to update live. <a href="{{ path('app_court_show', {id: case.id}) }}">Reload</a> to see progress.</p></noscript>
    </section>
{% elseif case.status == 'failed' %}
    <section class="panel court-failed" role="alert">
        <h2>The hearing could not finish</h2>
        <p>{{ case.failure }}</p>
        <a class="button button-secondary" href="{{ path('app_prospect_show', {id: prospect.id}) }}">Back to the report</a>
    </section>
{% else %}
    <section class="panel court-chat{{ case.ruling or not animate ? '' : ' is-fresh' }}" aria-labelledby="chat-title">
        <header class="chat-head">
            <h2 id="chat-title">The conversation</h2>
            <ul class="chat-legend" aria-label="Who is talking">
                <li><span class="chat-dot is-advocate">A</span>Advocate: wants to pursue</li>
                <li><span class="chat-dot is-skeptic">S</span>Skeptic: wants to check first</li>
                <li><span class="chat-dot is-clerk">{{ icons.icon('check', 12) }}</span>Clerk: checks the proof</li>
            </ul>
        </header>

        <ol class="chat-thread">
            {{ include('court/_thread.html.twig') }}
        </ol>

        <div class="chat-bottom" style="--i: {{ messages|length + 1 }}">
            <h3>Where it landed</h3>
            <p class="chat-headline">{{ bottom.headline }}</p>
            <ul class="chat-tally">
                <li><strong class="is-for">{{ bottom.for }}</strong> from the Advocate</li>
                <li><strong class="is-against">{{ bottom.against }}</strong> from the Skeptic</li>
                <li><strong>{{ bottom.answered }}</strong> {{ bottom.answered == 1 ? 'worry' : 'worries' }} answered back</li>
                <li><strong>{{ bottom.removed }}</strong> removed for having no proof</li>
            </ul>
            <p class="chat-hint">A count can't say which point matters most, and a reply can weaken a proven point. Read the conversation, then decide below.</p>
        </div>
    </section>

    <section class="panel court-judge" aria-labelledby="judge-title">
        {% if case.ruling %}
            <div class="court-verdict">
                <span class="court-avatar court-avatar-judge" aria-hidden="true">{{ icons.icon('scale', 18) }}</span>
                <div>
                    <h2 id="judge-title">Ruling: {{ {finalized: 'Pursue', rejected: 'Reject', needs_review: 'Needs more evidence'}[case.ruling.decision] ?? case.ruling.decision }}</h2>
                    <p>{{ case.ruling.reason }}</p>
                    <small>{{ case.ruling.actor.email }} · {{ case.ruling.createdAt|date('d M Y, H:i') }} · saved to <a href="{{ path('app_memory') }}">team memory</a></small>
                </div>
            </div>
        {% else %}
            <div class="panel-heading"><div><h2 id="judge-title">Your turn: what should the team do?</h2><p>Only a person decides. Your choice and your reason are saved to team memory, and future conversations about similar leads can point back to it.</p></div></div>
            <form method="post" action="{{ path('app_court_rule', {id: case.id}) }}" class="court-ruling-form">
                <input type="hidden" name="_token" value="{{ csrf_token('court_rule_' ~ case.id) }}">
                <fieldset class="court-choices">
                    <legend class="visually-hidden">Decision</legend>
                    <label class="court-choice court-choice-pursue"><input type="radio" name="decision" value="finalized" required><span>{{ icons.icon('check', 16) }}Pursue</span></label>
                    <label class="court-choice court-choice-more"><input type="radio" name="decision" value="needs_review"><span>{{ icons.icon('search', 16) }}Needs more evidence</span></label>
                    <label class="court-choice court-choice-reject"><input type="radio" name="decision" value="rejected"><span>{{ icons.icon('x', 16) }}Reject</span></label>
                </fieldset>
                <label for="court-reason">Why? <span>Required. The team will see this later.</span></label>
                <textarea id="court-reason" name="reason" rows="3" minlength="3" maxlength="960" required placeholder="For example: The no-online-ordering finding is admitted and fits our offer; confirm the owner contact first."></textarea>
                <button class="button button-primary" type="submit">Record ruling</button>
            </form>
        {% endif %}
    </section>

    <details class="panel court-explainer">
        <summary>How this conversation works</summary>
        <ol>
            <li><strong>Same file.</strong> Both sides get the lead, its score and the saved evidence. Nothing else.</li>
            <li><strong>They look before they talk.</strong> Each side is a Symfony AI agent that can open the evidence, the score breakdown and past team decisions for this lead only (<code>read_evidence</code>, <code>score_breakdown</code>, <code>team_precedents</code>).</li>
            <li><strong>Back and forth.</strong> The Advocate opens, the Skeptic replies to each point, and the Advocate answers the strongest objections.</li>
            <li><strong>The clerk checks proof.</strong> A plain PHP program, not an AI, removes any message that does not point to real saved proof, points to proof that does not exist, or just repeats the other side.</li>
            <li><strong>You decide.</strong> AI cannot decide, including from Claude or any other MCP client.</li>
        </ol>
    </details>
{% endif %}

<p class="court-footer">
    {% if case.provider %}{{ case.provider }} · {{ case.model }} · {{ (case.latencyMs / 1000)|round(1) }} s · {% endif %}
    Opened {{ case.openedVia == 'mcp' ? 'by an MCP client' : 'in the app' }}{% if case.openedBy %} by {{ case.openedBy.email }}{% endif %} · {{ case.createdAt|date('d M Y, H:i') }}
</p>
{% endblock %}
