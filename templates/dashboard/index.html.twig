{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}Command centre{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">{% endblock %}
{% block body %}
<header class="dash-head">
    <div>
        <p class="dash-date">{{ 'now'|date('l, j F') }}</p>
        <h1>
            {% if awaitingRuling > 0 %}
                {{ awaitingRuling }} {{ awaitingRuling == 1 ? 'hearing is' : 'hearings are' }} waiting for your ruling.
            {% elseif prospects is empty %}
                Start with one lead worth checking.
            {% else %}
                Nothing is waiting for your ruling.
            {% endif %}
        </h1>
        <p class="dash-lede">Research a lead, let two AI agents argue it from saved evidence, then decide. Every ruling becomes team memory.</p>
    </div>
    <div class="dash-actions">
        <a class="button button-primary" href="{{ path('app_research') }}">{{ icons.icon('search', 16) }}Start research</a>
        <a class="button button-secondary" href="{{ path('app_court') }}">{{ icons.icon('scale', 16) }}Evidence Court</a>
    </div>
</header>

<ol class="pipeline" aria-label="Your pipeline, from research to team memory">
    <li><a href="{{ path('app_research') }}">
        <span class="pipeline-step">1</span>
        <span class="pipeline-name">Research</span>
        <span class="pipeline-count" data-count-up>{{ pipeline.runs }}</span>
        <span class="pipeline-note">{{ pipeline.runs == 1 ? 'run' : 'runs' }}, {{ summary.researched }} {{ summary.researched == 1 ? 'lead' : 'leads' }} found</span>
    </a></li>
    <li><a href="#prospects">
        <span class="pipeline-step">2</span>
        <span class="pipeline-name">Evidence</span>
        <span class="pipeline-count" data-count-up>{{ pipeline.sources }}</span>
        <span class="pipeline-note">{{ pipeline.sources == 1 ? 'source' : 'sources' }} saved with a quote</span>
    </a></li>
    <li class="{{ awaitingRuling > 0 ? 'is-waiting' : '' }}"><a href="{{ path('app_court') }}">
        <span class="pipeline-step">3</span>
        <span class="pipeline-name">Evidence Court</span>
        <span class="pipeline-count" data-count-up>{{ hearings }}</span>
        <span class="pipeline-note">{% if awaitingRuling > 0 %}<strong>{{ awaitingRuling }} awaiting your ruling</strong>{% else %}{{ hearings == 1 ? 'hearing' : 'hearings' }} held{% endif %}</span>
    </a></li>
    <li><a href="{{ path('app_memory') }}">
        <span class="pipeline-step">4</span>
        <span class="pipeline-name">Team memory</span>
        <span class="pipeline-count" data-count-up>{{ pipeline.rulings }}</span>
        <span class="pipeline-note">{{ pipeline.rulings == 1 ? 'ruling' : 'rulings' }} the court can cite</span>
    </a></li>
</ol>

{% if not aiReady %}
<section class="ai-callout" role="note">
    <div><strong>AI is not connected yet.</strong><p>Research works without it. Evidence Court and AI summaries need one tested model connection.</p></div>
    <a class="button button-primary" href="{{ path('app_integrations_ai') }}">Connect AI</a>
</section>
{% endif %}

<div class="dash-grid">
    <section class="docket" aria-labelledby="docket-title">
        <div class="dash-section-head">
            <h2 id="docket-title">Awaiting your ruling</h2>
            <a class="text-link" href="{{ path('app_court') }}">All hearings</a>
        </div>
        {% if docket is empty %}
            <div class="docket-empty">
                <p>No hearing is waiting. Open a lead and put it on trial: the Advocate and the Skeptic argue it in about a minute.</p>
                <a class="button button-secondary" href="#prospects">Choose a lead</a>
            </div>
        {% else %}
            <ol class="docket-list">
                {% for case in docket %}
                    <li>
                        <a class="docket-case" href="{{ path('app_court_show', {id: case.id}) }}">
                            <span class="docket-no">#{{ case.id }}</span>
                            <span class="docket-lead">{{ case.lead }}</span>
                            <span class="docket-weights" aria-label="{{ case.for }} proven points for, {{ case.against }} against">
                                <span class="w-for">{{ case.for }} for</span><span class="w-against">{{ case.against }} against</span>
                            </span>
                            <span class="docket-meta">Opened {{ case.via == 'mcp' ? 'from an MCP client' : 'in the app' }}, {{ case.opened|date('j M, H:i') }}</span>
                            <span class="docket-go">Rule {{ icons.icon('chevron-left', 14, 'flip') }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </section>

    <section class="activity-panel dash-activity" id="activity" aria-labelledby="activity-title">
        <div class="dash-section-head"><h2 id="activity-title">Recent research</h2></div>
        {% if activity is empty %}
            <p class="dash-muted">No research yet. Your runs will appear here.</p>
        {% endif %}
        <ol class="activity-list">
        {% for item in activity %}
            <li class="activity-item"><span class="timeline-mark mark-{{ item.kind }}" aria-hidden="true">{{ icons.icon('search', 13) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.detail }}</p><time>{{ item.time }}</time></div></li>
        {% endfor %}
        </ol>
    </section>
</div>

<section class="leads" id="prospects" aria-labelledby="prospects-title">
    <div class="dash-section-head">
        <h2 id="prospects-title">Latest leads</h2>
        <a class="text-link" href="{{ path('app_memory') }}">All lead records</a>
    </div>
    {% if prospects is empty %}
        <div class="empty-state"><span class="empty-state-icon">{{ icons.icon('search', 24) }}</span><h3>No leads saved yet</h3><p>Start a web search to bring source-linked leads into this workspace.</p><a class="button button-primary" href="{{ path('app_research') }}">Start research</a></div>
    {% else %}
        <ul class="lead-list">
        {% for prospect in prospects %}
            <li>
                <a class="lead-row" href="{{ path('app_prospect_show', {id: prospect.id}) }}">
                    <span class="lead-mono" aria-hidden="true">{{ prospect.initials }}</span>
                    <span class="lead-main">
                        <span class="lead-name">{{ prospect.name }}</span>
                        <span class="lead-signal">{{ prospect.signal }}</span>
                    </span>
                    <span class="status-tag status-{{ prospect.status }}">{{ prospect.status|replace({'_': ' '})|capitalize }}</span>
                    <span class="lead-time">{{ prospect.updated }}</span>
                </a>
            </li>
        {% endfor %}
        </ul>
    {% endif %}
</section>
{% endblock %}
