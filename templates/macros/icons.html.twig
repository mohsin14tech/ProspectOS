{% macro icon(name, size = 20, class = '') %}
    <svg class="{{ class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {% if name == 'grid' %}<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>
        {% elseif name == 'search' %}<circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.3 4.3"/>
        {% elseif name == 'building' %}<path d="M4 20V6l8-3 8 3v14"/><path d="M8 9h1m6 0h1M8 13h1m6 0h1M9 20v-3h6v3"/>
        {% elseif name == 'activity' %}<path d="M3 12h4l3-8 4 16 3-8h4"/>
        {% elseif name == 'plug' %}<path d="M8 3v5m8-5v5M5 8h14v2a7 7 0 0 1-7 7v4m0-4a7 7 0 0 1-7-7V8Z"/>
        {% elseif name == 'chevron-down' %}<path d="m6 9 6 6 6-6"/>
        {% elseif name == 'arrow-up-right' %}<path d="M7 17 17 7M8 7h9v9"/>
        {% elseif name == 'mail' %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
        {% elseif name == 'sparkles' %}<path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Zm7 11 .9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14Z"/>
        {% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>
        {% elseif name == 'globe' %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
        {% endif %}
    </svg>
{% endmacro %}
