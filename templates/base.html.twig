<!doctype html>
{% import 'macros/icons.html.twig' as icons %}
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#f5f8fc">
        <meta name="description" content="ProspectOS helps you find and understand your next business opportunity.">
        <link rel="icon" type="image/svg+xml" href="{{ asset('icons/icon.svg') }}">
        <script>
            (() => {
                const root = document.documentElement;
                let preferences = { appearance: 'system', accent: 'blue', density: 'comfortable', sidebar: 'expanded' };
                try {
                    const saved = JSON.parse(localStorage.getItem('prospectos-preferences') || 'null');
                    if (saved && typeof saved === 'object') preferences = { ...preferences, ...saved };
                    if (!saved) {
                        const legacyTheme = localStorage.getItem('prospectos-theme');
                        if (legacyTheme === 'light' || legacyTheme === 'dark') preferences.appearance = legacyTheme;
                    }
                } catch {}
                if (!['system', 'light', 'dark'].includes(preferences.appearance)) preferences.appearance = 'system';
                if (!['blue', 'indigo', 'teal', 'graphite'].includes(preferences.accent)) preferences.accent = 'blue';
                if (!['comfortable', 'compact'].includes(preferences.density)) preferences.density = 'comfortable';
                if (!['expanded', 'compact'].includes(preferences.sidebar)) preferences.sidebar = 'expanded';
                root.dataset.appearance = preferences.appearance;
                root.dataset.theme = preferences.appearance === 'system'
                    ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : preferences.appearance;
                root.dataset.accent = preferences.accent;
                root.dataset.density = preferences.density;
                root.dataset.sidebar = preferences.sidebar;
                document.querySelector('meta[name="theme-color"]').content = root.dataset.theme === 'dark' ? '#1c1c1e' : '#f5f5f7';
            })();
        </script>
        <title>{% block title %}ProspectOS{% endblock %} · 14 Technologies</title>
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">
        {{ importmap('app') }}
        {% block stylesheets %}{% endblock %}
        <link rel="stylesheet" href="{{ asset('styles/system-ui.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/premium.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/finish.css') }}">
        <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
        <meta name="view-transition" content="same-origin">
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <div class="app-shell">
            <aside class="sidebar" id="main-navigation" aria-label="Main navigation">
                <div class="sidebar-head">
                    <a class="brand" href="{{ path('app_dashboard') }}" aria-label="ProspectOS home" title="ProspectOS">
                        <span class="brand-mark" aria-hidden="true">{% include '_mascot.html.twig' with {size: 34, class: 'brand-mascot', track: true} %}</span>
                        <span class="brand-copy"><strong>ProspectOS</strong><small>by 14 Technologies</small></span>
                    </a>
                    {# Panel icon (as in Linear/Notion). Collapsed: it replaces the mascot on hover. Shortcut: [ #}
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="main-navigation" aria-label="Collapse sidebar" title="Collapse sidebar  [">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3.5"/><path d="M9.5 4v16"/><path class="sidebar-toggle-chevron" d="m16 10-2 2 2 2"/></svg>
                    </button>
                </div>
                <a class="workspace-switcher" href="{{ path('app_workspace') }}" title="Workspace settings"><span class="workspace-dot" aria-hidden="true"></span><span class="workspace-label">{{ workspace.name|default('Workspace settings') }}</span>{{ icons.icon('chevron-down', 16, 'chevron-icon') }}</a>
                <nav class="primary-nav">
                    <span class="nav-caption">Workspace</span>
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'is-active' : '' }}" href="{{ path('app_dashboard') }}" title="Command centre">{{ icons.icon('grid', 19, 'nav-icon') }}<span class="nav-label">Command centre</span></a>
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_research' ? 'is-active' : '' }}" href="{{ path('app_research') }}" title="Research">{{ icons.icon('search', 19, 'nav-icon') }}<span class="nav-label">Research</span></a>
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_court' ? 'is-active' : '' }}" href="{{ path('app_court') }}" title="Evidence Court">{{ icons.icon('scale', 19, 'nav-icon') }}<span class="nav-label">Evidence Court</span></a>
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_memory' ? 'is-active' : '' }}" href="{{ path('app_memory') }}" title="Memory">{{ icons.icon('bookmark', 19, 'nav-icon') }}<span class="nav-label">Memory</span></a>
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_inbox' or app.request.attributes.get('_route') starts with 'app_outreach' or app.request.attributes.get('_route') starts with 'app_mailbox' or app.request.attributes.get('_route') starts with 'app_email' ? 'is-active' : '' }}" href="{{ path('app_inbox') }}" title="Email">{{ icons.icon('mail', 19, 'nav-icon') }}<span class="nav-label">Email</span></a>
                    <a class="nav-link" href="{{ path('app_dashboard') }}#prospects" title="Prospects">{{ icons.icon('users', 19, 'nav-icon') }}<span class="nav-label">Prospects</span></a>
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_integrations' ? 'is-active' : '' }}" href="{{ path('app_integrations') }}" title="Integrations">{{ icons.icon('plug', 19, 'nav-icon') }}<span class="nav-label">Integrations</span></a>
                    <a class="nav-link" href="{{ path('app_dashboard') }}#activity" title="Activity">{{ icons.icon('activity', 19, 'nav-icon') }}<span class="nav-label">Activity</span></a>
                </nav>
                <div class="sidebar-bottom">
                    <a class="profile-link" href="{{ path('app_workspace') }}"><span class="profile-avatar">{{ app.user.email|slice(0, 1)|upper }}</span><span><strong>{{ app.user.email }}</strong><small>Workspace access</small></span></a>
                    <form method="post" action="{{ path('_logout_main') }}" class="logout-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button type="submit">Sign out</button></form>
                </div>
            </aside>
            <div class="main-column">
                <header class="topbar">
                    <a class="topbar-brand" href="{{ path('app_dashboard') }}" aria-label="ProspectOS home">{% include '_mascot.html.twig' with {size: 30, class: 'brand-mascot'} %}</a>
                    <div class="breadcrumbs"><span>Workspace</span><span class="crumb-separator">/</span><strong>{% block breadcrumb %}Command centre{% endblock %}</strong></div>
                    <div class="topbar-actions">
                        <button class="theme-toggle theme-icon-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch theme" title="Switch theme">
                            <svg class="theme-icon theme-icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                            <svg class="theme-icon theme-icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                        </button>
                        <div class="appearance-control" data-appearance-control>
                            <button class="appearance-trigger" type="button" aria-expanded="false" aria-controls="appearance-panel" data-appearance-trigger>
                                {{ icons.icon('sliders', 18, 'appearance-trigger-icon') }}<span>Appearance</span>
                            </button>
                            <section class="appearance-panel" id="appearance-panel" aria-label="Personalize ProspectOS" hidden data-appearance-panel>
                                <div class="appearance-panel-heading"><div><strong>Make it yours</strong><p>Preferences stay in this browser.</p></div><button class="appearance-close" type="button" aria-label="Close appearance settings" data-appearance-close>×</button></div>
                                <fieldset class="preference-group"><legend>Appearance</legend><div class="preference-segment" role="group" aria-label="Appearance mode">
                                    <button type="button" data-preference="appearance" data-value="system">System</button><button type="button" data-preference="appearance" data-value="light">Light</button><button type="button" data-preference="appearance" data-value="dark">Dark</button>
                                </div></fieldset>
                                <fieldset class="preference-group"><legend>Accent color</legend><div class="accent-options" role="group" aria-label="Accent color">
                                    <button type="button" class="accent-swatch accent-blue" data-preference="accent" data-value="blue" aria-label="Blue accent" title="Blue"></button><button type="button" class="accent-swatch accent-indigo" data-preference="accent" data-value="indigo" aria-label="Indigo accent" title="Indigo"></button><button type="button" class="accent-swatch accent-teal" data-preference="accent" data-value="teal" aria-label="Teal accent" title="Teal"></button><button type="button" class="accent-swatch accent-graphite" data-preference="accent" data-value="graphite" aria-label="Graphite accent" title="Graphite"></button>
                                </div></fieldset>
                                <fieldset class="preference-group"><legend>Spacing</legend><div class="preference-segment" role="group" aria-label="Interface spacing">
                                    <button type="button" data-preference="density" data-value="comfortable">Comfortable</button><button type="button" data-preference="density" data-value="compact">Compact</button>
                                </div></fieldset>
                                <div class="preference-row"><div><strong>Compact sidebar</strong><small>Show icons only</small></div><button class="preference-switch" type="button" role="switch" aria-checked="false" aria-label="Compact sidebar" data-preference="sidebar" data-value="compact"><span></span></button></div>
                                <button class="preference-reset" type="button" data-preference-reset>Reset preferences</button>
                            </section>
                        </div>
                        <span class="demo-pill">{{ workspace.name|default('Workspace') }}</span>
                        <a class="topbar-avatar" href="{{ path('app_workspace') }}" aria-label="Workspace settings">{{ app.user.email|slice(0, 1)|upper }}</a>
                    </div>
                </header>
                <main id="main-content" class="page-content">
                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
        <nav class="mobile-nav" aria-label="Mobile navigation">
            <a class="{{ app.request.attributes.get('_route') == 'app_dashboard' ? 'is-active' : '' }}" href="{{ path('app_dashboard') }}">{{ icons.icon('grid', 20) }}Home</a>
            <a class="{{ app.request.attributes.get('_route') == 'app_research' ? 'is-active' : '' }}" href="{{ path('app_research') }}">{{ icons.icon('search', 20) }}Research</a>
            <a class="{{ app.request.attributes.get('_route') starts with 'app_court' ? 'is-active' : '' }}" href="{{ path('app_court') }}">{{ icons.icon('scale', 20) }}Court</a>
            <a class="{{ app.request.attributes.get('_route') starts with 'app_memory' ? 'is-active' : '' }}" href="{{ path('app_memory') }}">{{ icons.icon('bookmark', 20) }}Memory</a>
            <a class="{{ app.request.attributes.get('_route') starts with 'app_inbox' or app.request.attributes.get('_route') starts with 'app_outreach' or app.request.attributes.get('_route') starts with 'app_mailbox' or app.request.attributes.get('_route') starts with 'app_email' ? 'is-active' : '' }}" href="{{ path('app_inbox') }}">{{ icons.icon('mail', 20) }}Email</a>
            <a class="{{ app.request.attributes.get('_route') == 'app_integrations' ? 'is-active' : '' }}" href="{{ path('app_integrations') }}">{{ icons.icon('plug', 20) }}Connect</a>
        </nav>
    </body>
</html>
