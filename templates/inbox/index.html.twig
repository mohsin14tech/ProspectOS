{% extends 'base.html.twig' %}
{% block title %}Inbox{% endblock %}
{% block breadcrumb %}Email / Inbox{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/mail.css') }}">{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Inbox</h1><p class="page-subtitle">Recent messages from your connected mailboxes, shared with this workspace.</p></div><a class="button button-secondary" href="{{ path('app_outreach') }}">Email connections</a></div>
{% include 'outreach/_flashes.html.twig' %}
<section class="panel mail-panel"><h2>Sync recent mail</h2><p>Fetch up to 10 recent inbox messages per connection. Bodies load only when requested; messages stay unread at your provider.</p>
<div class="mail-actions">
{% if gmail and gmail.inboxAccess %}<form method="post" action="{{ path('app_inbox_sync', {provider: 'gmail'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sync_gmail') }}"><button class="button button-primary" data-turbo-submits-with="Syncing Gmail…">Sync Gmail</button></form>{% endif %}
{% if business and business.testedAt %}<form method="post" action="{{ path('app_inbox_sync', {provider: 'business'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sync_business') }}"><button class="button {{ gmail and gmail.inboxAccess ? 'button-secondary' : 'button-primary' }}" data-turbo-submits-with="Syncing IMAP…">Sync IMAP inbox</button></form>{% endif %}
{% if not (gmail and gmail.inboxAccess) and not (business and business.testedAt) %}<a class="button button-primary" href="{{ path('app_outreach') }}">Connect a mailbox</a>{% endif %}
</div></section>
<section class="panel mail-panel"><h2>Cached messages</h2><p class="mail-note">Up to 100 recent cached messages per mailbox. This is not a full mailbox mirror; deleted or moved provider messages can remain until the cache is cleared.</p>
{% for message in messages %}<a class="mail-row" href="{{ path('app_inbox_show', {id: message.id}) }}"><div class="mail-row-heading"><strong>{{ message.metadata.subject ?: '(No subject)' }}</strong><span class="status-tag">{{ message.gmailConnection ? 'Gmail' : 'IMAP' }}</span></div><span>{{ message.metadata.sender }}</span><small>{{ message.metadata.date }} · Cached {{ message.syncedAt|date('d M Y, H:i') }}</small></a>
{% else %}<div class="mail-empty"><h3>No messages synced yet</h3><p>Connect a mailbox, then sync to see its recent inbox messages here.</p></div>{% endfor %}
</section>
{% if messages is not empty %}<details class="panel mail-panel"><summary>Local cache controls</summary><p>Workspace admins can clear cached headers and bodies. Mail at your provider remains unchanged.</p><form method="post" action="{{ path('app_inbox_clear') }}"><input type="hidden" name="_token" value="{{ csrf_token('clear_mail') }}"><button class="button button-secondary">Clear local mail cache</button></form></details>{% endif %}
{% endblock %}
