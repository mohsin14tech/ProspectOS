{% extends 'base.html.twig' %}

{% block title %}{{ message.subject }} · Inbox{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_inbox') }}">Inbox</a> / Thread{% endblock %}

{% block body %}
    <p class="report-back"><a class="text-link" href="{{ path('app_inbox') }}">← Back to inbox</a></p>
    <div class="page-heading">
        <div><div class="eyebrow">MailOS thread · {{ thread|length }} synced header{{ thread|length == 1 ? '' : 's' }}</div><h1>{{ message.subject }}</h1><p class="page-subtitle">Thread details are limited to headers. Open the original in MailOS to read or reply.</p></div>
    </div>
    <section class="panel inbox-list-panel" aria-label="Thread message headers">
        <ol class="thread-list">
            {% for item in thread %}
                <li class="thread-message">
                    <div class="thread-message-top"><strong>{{ item.fromAddress }}</strong><time datetime="{{ item.receivedAt|date('c') }}">{{ item.receivedAt|date('M j, Y · H:i') }}</time></div>
                    <p>To {{ item.toAddress ?: 'Not provided' }}</p>
                    <h2>{{ item.subject }}</h2>
                    <span class="status-tag">{{ item.read ? 'Read' : 'Unread' }}</span>
                </li>
            {% endfor %}
        </ol>
        <a class="button button-secondary" href="https://mail.14technologies.com" target="_blank" rel="noopener noreferrer">Open MailOS</a>
    </section>
{% endblock %}
