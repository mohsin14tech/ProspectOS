APP_ENV=dev
DEFAULT_URI=http://localhost
APP_SECRET=replace-with-a-random-local-secret
APP_OWNER_SETUP_TOKEN=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://127.0.0.1:8000/login/google/callback
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app?serverVersion=16&charset=utf8
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b
AI_PROVIDER=disabled
AI_MODEL=qwen3.5:4b
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
MAILOS_BASE_URL=https://mail.14technologies.com
MAILOS_API_KEY=
MAILOS_MAILBOX_ID=
MAILOS_READ_ONLY_SCOPE_CONFIRMED=false
BRAVE_SEARCH_API_KEY=
SEARCH_PROVIDER=demo
# If running SearXNG via Compose, its internal address is set by compose.yaml.
SEARXNG_BASE_URL=http://127.0.0.1:8081
SEARXNG_SECRET=replace-with-a-random-local-secret
