<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <php>
        <env name="APP_ENV" value="test" force="true" />
        <env name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <env name="DEFAULT_URI" value="http://localhost" force="true" />
        <env name="SEARCH_PROVIDER" value="demo" force="true" />
        <env name="SEARXNG_BASE_URL" value="http://searxng:8080" force="true" />
        <env name="HF_TOKEN" value="" force="true" />
        <env name="HF_MODEL" value="openai/gpt-oss-120b" force="true" />
        <env name="APP_OWNER_SETUP_TOKEN" value="test-only-bootstrap-key-not-for-real-use" force="true" />
        <env name="GOOGLE_OIDC_CLIENT_ID" value="" force="true" />
        <env name="GOOGLE_OIDC_CLIENT_SECRET" value="" force="true" />
        <env name="GOOGLE_OIDC_REDIRECT_URI" value="http://127.0.0.1:8000/login/google/callback" force="true" />
        <env name="AI_PROVIDER" value="disabled" force="true" />
        <env name="AI_MODEL" value="qwen3.5:4b" force="true" />
        <env name="AI_BASE_URL" value="http://host.docker.internal:11434/v1" force="true" />
        <env name="AI_API_KEY" value="" force="true" />
        <env name="MAILOS_BASE_URL" value="https://mail.14technologies.com" force="true" />
        <env name="MAILOS_API_KEY" value="" force="true" />
        <env name="MAILOS_MAILBOX_ID" value="" force="true" />
        <env name="MAILOS_READ_ONLY_SCOPE_CONFIRMED" value="false" force="true" />
    </php>
    <testsuites>
        <testsuite name="ProspectOS">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
